# ─────────────────────────────────────────────────────────────
# Tekfinity Store — Environment Variables
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` or real secrets to git.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for SEO, sitemap, catalog feed links)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── Supabase (REQUIRED for production database + auth) ──
# Project URL: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Anon/public key (safe for browser, RLS-protected)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Service role key — SERVER ONLY. Bypasses RLS. Never expose to client.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Admin Panel ──
# Credentials for /admin login (email + password, session cookie signed with this secret)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# Secret used to sign admin session cookies (generate: openssl rand -hex 32)
ADMIN_SESSION_SECRET=change-me-random-hex

# ── Optional integrations (Setup required) ──
# WhatsApp Business API for automated abandoned-cart reminders
# (the floating WhatsApp button works without this; only automated messaging needs it)
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Meta / Instagram catalog sync — point Meta Commerce Manager at:
#   GET {NEXT_PUBLIC_SITE_URL}/api/catalog
# No credentials needed for the feed itself; Meta catalog setup requires
# a Facebook Business account + Commerce Manager approval.

# Future payment gateway (Phase 2) — manual payments work without these
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
